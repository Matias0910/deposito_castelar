{
  "version": 2,
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "artifacts/deposito-castelar/dist/public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}